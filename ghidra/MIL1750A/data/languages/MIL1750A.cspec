<?xml version="1.0" encoding="UTF-8"?>

<!-- The standard defines no calling convention. This one is inferred from GCC-compiled
     Dhrystone in samples/: arguments in R0 upward, the result in R0, R14 as the saved frame
     pointer, R15 as the stack pointer, and SJS R15 / URS R15 for calls. Functions there use
     R0-R6 without saving them and never touch R7-R13, so those seven are left unclassified.
     Other compilers, and hand-written code, may differ.

     SJS pushes the return address before the call and URS pops it, so a call moves R15 by
     one word overall. Sizes are in bytes and stack offsets in words. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="2"/>
    <default_alignment value="2"/>
    <default_pointer_alignment value="2"/>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="4"/>
    <float_size value="4"/>
    <double_size value="6"/>
    <long_double_size value="6"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="R15" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" extrapop="1" stackshift="1">
      <input>
        <pentry minsize="1" maxsize="2"><register name="R0"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R1"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R2"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R3"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R4"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R5"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2"><register name="R0"/></pentry>
        <pentry minsize="3" maxsize="4"><addr space="join" piece1="R0" piece2="R1"/></pentry>
        <pentry minsize="5" maxsize="6"><addr space="join" piece1="R0" piece2="R1" piece3="R2"/></pentry>
      </output>
      <unaffected>
        <register name="R14"/>
        <register name="R15"/>
      </unaffected>
      <killedbycall>
        <register name="R0"/>
        <register name="R1"/>
        <register name="R2"/>
        <register name="R3"/>
        <register name="R4"/>
        <register name="R5"/>
        <register name="R6"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
