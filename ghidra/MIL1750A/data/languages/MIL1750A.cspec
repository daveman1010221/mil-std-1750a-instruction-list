<?xml version="1.0" encoding="UTF-8"?>

<!-- The standard defines no calling convention, so this is a placeholder until one is
     known for the target compiler. R15 is the stack pointer PSHM and POPM use. -->
<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="R15" space="ram"/>
  <default_proto>
    <prototype name="unknown" extrapop="unknown" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="R15"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
